# ==============================================================================
# Second Opinion - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the project root or backend directory.
# NEVER commit .env to version control or expose API keys to the frontend.
# ==============================================================================

# LLM Provider Configuration (Google Gemini)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# Required in Phase 2 for atomic claim extraction. Automated test suites run with mocks.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Backend & Database Settings
# By default, SQLite database is stored locally in backend/data/second_opinion.db
DATABASE_URL=sqlite:///./data/second_opinion.db

# CORS & Frontend Origins
# Allowed origin for local Vite development frontend
FRONTEND_ORIGIN=http://localhost:5173

# Source Processing & PDF Limits
MAX_PDF_SIZE_MB=10

# Service Timeouts & Rate Limits
LLM_TIMEOUT_SECONDS=30
